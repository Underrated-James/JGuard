{
  "name": "jguard",
  "displayName": "JGuard",
  "description": "A safe checkpoint and rollback system for AI-generated code changes.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jguard.toggleProtection",
        "title": "JGuard: Toggle Protection",
        "icon": "$(shield)"
      },
      {
        "command": "jguard.toggleChanges",
        "title": "JGuard: Toggle AI Changes (All)",
        "icon": "$(versions)"
      },
      {
        "command": "jguard.acceptAll",
        "title": "JGuard: Accept All Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "jguard.rejectAll",
        "title": "JGuard: Reject All Changes",
        "icon": "$(discard)"
      },
      {
        "command": "jguard.refresh",
        "title": "JGuard: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "jguard.acceptFile",
        "title": "JGuard: Accept File",
        "icon": "$(check)"
      },
      {
        "command": "jguard.rejectFile",
        "title": "JGuard: Reject File",
        "icon": "$(close)"
      },
      {
        "command": "jguard.toggleFile",
        "title": "JGuard: Toggle File",
        "icon": "$(eye)"
      },
      {
        "command": "jguard.finalize",
        "title": "JGuard: Finalize Session",
        "icon": "$(pass-filled)"
      },
      {
        "command": "jguard.showHistoryDetails",
        "title": "JGuard: View Session Details",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jguard-container",
          "title": "JGuard",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "jguard-container": [
        {
          "id": "jguardSidebar",
          "name": "Active Session"
        },
        {
          "id": "jguardHistory",
          "name": "Session History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jguard.toggleChanges",
          "when": "view == jguardSidebar",
          "group": "navigation@1"
        },
        {
          "command": "jguard.acceptAll",
          "when": "view == jguardSidebar",
          "group": "navigation@2"
        },
        {
          "command": "jguard.rejectAll",
          "when": "view == jguardSidebar",
          "group": "navigation@3"
        },
        {
          "command": "jguard.finalize",
          "when": "view == jguardSidebar",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "jguard.acceptFile",
          "when": "viewItem == jguard.changeItem",
          "group": "inline@1"
        },
        {
          "command": "jguard.rejectFile",
          "when": "viewItem == jguard.changeItem",
          "group": "inline@2"
        },
        {
          "command": "jguard.toggleFile",
          "when": "viewItem == jguard.changeItem || viewItem == jguard.changeItem.rejected",
          "group": "inline@3"
        },
        {
          "command": "jguard.showHistoryDetails",
          "when": "viewItem == jguard.historyItem",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "JGuard",
      "properties": {
        "jguard.undoGracePeriodMinutes": {
          "type": "number",
          "default": 5,
          "description": "Minutes after accepting changes during which you can undo the accept."
        },
        "jguard.enableGarbageCollection": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic garbage collection of orphaned checkpoint files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm run check-types && node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --noEmit",
    "watch-tests": "tsc -p . -w --noEmit",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
